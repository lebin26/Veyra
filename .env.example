# ==============================================================================
# Veyra Trading - Environment Variables Template
# Copy this file to .env and insert your real credentials.
# NEVER commit your actual .env file or real secrets into version control!
# ==============================================================================

# Supabase Public Client Credentials (Safe to expose to frontend browser)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"

# Supabase Service Role Key (STRICTLY SERVER-SIDE ONLY - NEVER put in frontend!)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"

# Initial Admin Bootstrap Credentials (Used once by seed script)
INITIAL_ADMIN_EMAIL="admin@veyra.io"
INITIAL_ADMIN_PASSWORD="YOUR_TEMPORARY_ADMIN_PASSWORD"
